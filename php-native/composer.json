{
    "name": "danyun/danchat",
    "description": "单聊辅助 - 学员信息管理系统 (PHP 8.5 + MySQL 5.7 + Nginx 1.31.1)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-zip": "*",
        "ext-openssl": "*",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "DanChat\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
